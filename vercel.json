{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/p/:id",
      "destination": "/api/share?type=p&id=:id"
    },
    {
      "source": "/shop/:id",
      "destination": "/api/share?type=shop&id=:id"
    }
  ],
  "functions": {
    "api/share.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
